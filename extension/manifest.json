{
  "manifest_version": 3,
  "name": "Veritas AI",
  "version": "0.1.0",
  "description": "Flags AI-generated images as you browse. Click the badge on an image to check it.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": ["<all_urls>"],
  "permissions": ["storage"]
}
